{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spity release journal record",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "status",
    "title",
    "identity",
    "changes",
    "documentation",
    "rollback",
    "history",
    "evidence"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "pattern": "^SPITY-REL-\\d{4}-\\d{4}$" },
    "status": { "enum": ["published", "observed-production", "candidate"] },
    "identity": {
      "type": "object",
      "required": ["version", "revision"],
      "properties": {
        "version": { "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
        "tag": { "pattern": "^v\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
        "revision": { "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "changes": {
      "type": "object",
      "required": ["features", "corrections"],
      "properties": {
        "features": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "corrections": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
