# Local MariaDB container
MARIADB_ROOT_PASSWORD="replace_with_a_distinct_local_root_password"
MARIADB_DATABASE="spity"
MARIADB_USER="spity"
MARIADB_PASSWORD="replace_with_a_local_application_password"
MARIADB_PORT="3306"
PHPMYADMIN_PORT="8083"

# Keep this URL consistent with the MariaDB values above.
DATABASE_URL="mysql://spity:replace_with_a_local_application_password@127.0.0.1:3306/spity"

# JWT Secret - Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 characters
JWT_SECRET="your_jwt_secret_here_minimum_32_characters"

# Runtime environment
NODE_ENV="development"
