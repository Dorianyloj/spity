{
  "name": "spity",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "test:integration": "node --env-file-if-exists=.env.local --test --test-concurrency=1 tests/integration/*.test.mjs",
    "test:maintenance": "node --test --test-concurrency=1 tests/maintenance/*.test.mjs",
    "test:acceptance": "node --env-file-if-exists=.env.local node_modules/@playwright/test/cli.js test",
    "test:acceptance:report": "playwright show-report",
    "docs:build": "node scripts/build-bc02-dossier.mjs",
    "docs:capture": "node --env-file-if-exists=.env.local scripts/capture-bc02-evidence.mjs",
    "docs:capture:github": "node scripts/capture-bc02-github-evidence.mjs",
    "accessibility:audit": "node --env-file-if-exists=.env.local scripts/run-authenticated-accessibility.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "perf:audit": "npm run build && node scripts/run-lighthouse.mjs",
    "deployment:verify": "node scripts/verify-deployment.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "releases:check": "node scripts/check-release-journal.mjs",
    "releases:exercise": "node scripts/run-release-journal-exercise.mjs",
    "support:check": "node scripts/check-support-collaborations.mjs",
    "support:exercise": "node scripts/run-support-collaboration-exercise.mjs",
    "dependencies:check": "node scripts/check-dependency-policy.mjs",
    "improvements:check": "node scripts/check-improvement-backlog.mjs",
    "improvements:exercise": "node scripts/run-improvement-review-exercise.mjs",
    "incidents:check": "node scripts/check-incident-registry.mjs",
    "incidents:exercise": "node scripts/run-incident-registry-exercise.mjs",
    "bloc4:capture": "node scripts/capture-bloc4-evidence.mjs",
    "bloc4:visuals": "node scripts/capture-bloc4-visual-evidence.mjs",
    "bloc4:tech-visuals": "node scripts/capture-bloc4-technical-evidence.mjs",
    "bloc4:incidents": "node scripts/capture-incident-registry-evidence.mjs",
    "bloc4:improvements": "node scripts/capture-improvement-backlog-evidence.mjs",
    "bloc4:releases": "node scripts/capture-release-journal-evidence.mjs",
    "bloc4:support": "node scripts/capture-support-collaboration-evidence.mjs",
    "bloc4:check": "node scripts/check-bloc4-completeness.mjs",
    "bloc4:final-audit": "node scripts/capture-bloc4-completeness-evidence.mjs",
    "bloc4:exercise": "node scripts/run-monitoring-exercise.mjs",
    "bloc4:deployment-exercise": "node scripts/run-deployment-verification-exercise.mjs",
    "bloc4:manifest": "node scripts/build-bloc4-manifest.mjs",
    "bloc4:pdf": "python scripts/build-bloc4-dossier.py",
    "monitoring:probe": "node scripts/run-production-monitor.mjs",
    "monitoring:slo": "node scripts/capture-monitoring-slo.mjs",
    "quality": "npm run lint && npm run typecheck && npm run test:coverage && npm run test:maintenance && npm run incidents:check && npm run improvements:check && npm run releases:check && npm run support:check && npm run bloc4:check && npm run dependencies:check && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node scripts/seed-demo.mjs",
    "images:demo": "node scripts/download-demo-images.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.29.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.562.0",
    "mysql2": "^3.16.1",
    "next": "^16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.75.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "jest": "^30.4.2",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "lighthouse": "^13.4.1",
    "marked": "^18.0.6",
    "puppeteer-core": "^25.6.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^7"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.26",
      "sharp": "0.35.3"
    }
  }
}
