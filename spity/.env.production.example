# Remplacer toutes les valeurs CHANGE_ME avant le déploiement.
DATABASE_URL="mysql://spity:CHANGE_ME_URL_SAFE_PASSWORD@mariadb:3306/spity"
JWT_SECRET="CHANGE_ME_WITH_A_RANDOM_SECRET_OF_AT_LEAST_64_CHARACTERS"

# Docker Compose - production
MYSQL_DATABASE="spity"
MYSQL_USER="spity"
MYSQL_PASSWORD="CHANGE_ME_URL_SAFE_PASSWORD"
MYSQL_ROOT_PASSWORD="CHANGE_ME_WITH_ANOTHER_RANDOM_PASSWORD"
APP_HOST="127.0.0.1"
APP_PORT="3000"
APP_VERSION="latest"
